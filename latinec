<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LATI-MEC - Tecnología que Escucha tu Vehículo</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --bg-dark: #0d0e15;
            --bg-card: #141625;
            --neon-violet: #9d4edd;
            --neon-purple: #a855f7;
            --neon-cyan: #00f2fe;
        }

        body {
            background-color: var(--bg-dark);
            color: #e2e8f0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            overflow-x: hidden;
        }

        .glow-purple {
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
        }
        .glow-cyan {
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
        }
        .glow-green {
            box-shadow: 0 0 15px rgba(34, 197, 94, 0.4);
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0d0e15;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e2035;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #9d4edd;
        }

        .glass-panel {
            background: rgba(20, 22, 37, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(168, 85, 247, 0.2);
        }

        .glass-nav {
            background: rgba(13, 14, 21, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid rgba(168, 85, 247, 0.3);
        }

        .nav-item.active {
            color: #00f2fe;
            position: relative;
        }
        .nav-item.active::after {
            content: '';
            position: absolute;
            top: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 3px;
            background-color: #00f2fe;
            border-radius: 2px;
            box-shadow: 0 0 10px #00f2fe;
        }
    </style>
</head>
<body class="min-h-screen pb-24 flex flex-col justify-between">

    <!-- HEADER -->
    <header class="sticky top-0 z-40 glass-panel border-b border-purple-900/40 px-4 py-3 shadow-lg">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-cyan-400 p-0.5 glow-purple">
                    <div class="w-full h-full bg-[#0d0e15] rounded-[10px] flex items-center justify-center">
                        <i data-lucide="activity" class="w-6 h-6 text-cyan-400 animate-pulse"></i>
                    </div>
                </div>
                <div>
                    <h1 class="font-extrabold text-xl tracking-wider bg-gradient-to-r from-purple-400 via-fuchsia-400 to-cyan-400 bg-clip-text text-transparent">
                        LATI-MEC
                    </h1>
                    <p class="text-[10px] tracking-widest text-cyan-400 font-semibold uppercase">
                        Tecnología que escucha tu vehículo
                    </p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <div class="flex items-center space-x-2 bg-purple-950/40 border border-purple-500/30 rounded-full px-3 py-1">
                    <div id="connection-indicator" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                    <span id="connection-text" class="text-xs text-slate-300 font-medium">Gemini IA Online</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 pt-6 w-full flex-1">

        <!-- INICIO / DIAGNÓSTICO -->
        <section id="tab-home" class="tab-content space-y-6">
            <div class="relative overflow-hidden rounded-2xl glass-panel p-6 border border-purple-500/30 bg-gradient-to-r from-purple-950/40 to-slate-900/60">
                <div class="relative z-10 max-w-2xl">
                    <span class="px-3 py-1 text-xs font-bold rounded-full bg-purple-900/60 text-purple-300 border border-purple-500/40 uppercase tracking-widest">
                        Sistema Acústico Conectado a la Nube
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black mt-3 text-white">
                        Diagnóstico por Sonido con <span class="bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">Gemini IA Online</span>
                    </h2>
                    <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                        Conectado a internet para enviar la muestra de audio en tiempo real a la nube, procesar el espectro de frecuencias y obtener un diagnóstico mecánico preciso.
                    </p>
                </div>
            </div>

            <!-- Escáner Acústico e Integración Cloud -->
            <div class="glass-panel rounded-2xl p-6 border border-purple-500/30 relative space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-cyan-300 flex items-center gap-2">
                            <i data-lucide="cloud-lightning" class="w-5 h-5 text-cyan-400"></i>
                            Escáner Cloud con Gemini IA
                        </h3>
                        <p class="text-xs text-slate-400">Captura el sonido del motor y conéctate a internet para el análisis inteligente</p>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <button id="btn-toggle-audio" onclick="toggleCloudAcousticScan()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-black font-bold text-xs flex items-center gap-2 shadow-lg glow-cyan transition-all">
                            <i id="audio-icon" data-lucide="mic" class="w-4 h-4"></i>
                            <span id="audio-btn-text">Iniciar Escaneo Online</span>
                        </button>
                    </div>
                </div>

                <div class="w-full bg-[#090a10] rounded-xl p-4 border border-slate-800 relative overflow-hidden flex flex-col items-center justify-center min-h-[180px]">
                    <div id="wave-bars-container" class="flex items-center justify-center gap-1.5 h-24 w-full">
                        <div class="w-1.5 bg-cyan-400 rounded-full h-6 transition-all duration-150"></div>
                        <div class="w-1.5 bg-purple-500 rounded-full h-14 transition-all duration-150"></div>
                        <div class="w-1.5 bg-cyan-400 rounded-full h-20 transition-all duration-150"></div>
                        <div class="w-1.5 bg-purple-500 rounded-full h-10 transition-all duration-150"></div>
                        <div class="w-1.5 bg-cyan-400 rounded-full h-16 transition-all duration-150"></div>
                    </div>
                    <div id="diagnostic-status" class="mt-4 text-center px-4">
                        <span class="text-xs text-slate-400 font-mono">ESTADO: LISTO. ASEGÚRATE DE ABRIR ESTA PÁGINA EN SERVIDOR LOCAL O HTTPS Y OTORGAR PERMISO DE MICRÓFONO.</span>
                    </div>
                </div>
            </div>

            <!-- Matriz de Patrones Sonoros -->
            <div>
                <h3 class="text-base font-bold text-purple-300 mb-4 flex items-center gap-2">
                    <i data-lucide="list-checks" class="w-5 h-5 text-purple-400"></i>
                    Catálogo Extendido de Patrones Sonoros (Haz clic para ver detalles)
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    
                    <!-- 1. Bujías -->
                    <div onclick="toggleFaultCard('card-bujia')" class="glass-panel p-4 rounded-xl border border-slate-800 hover:border-purple-500/50 transition-all cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <div class="p-2 rounded-lg bg-purple-950/60 text-purple-300"><i data-lucide="zap" class="w-5 h-5"></i></div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-950/60 text-red-400 border border-red-800/40">Falla Alta</span>
                        </div>
                        <h4 class="font-bold text-white mt-3 text-sm flex items-center justify-between">
                            Bujías / Falla de Chispa
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-cyan-400 transition-transform"></i>
                        </h4>
                        <p class="text-xs text-slate-400 mt-1">Chasquido rítmico o tirones intermitentes al acelerar.</p>
                        
                        <div id="card-bujia" class="hidden mt-3 pt-3 border-t border-slate-800 space-y-2 text-xs text-slate-300">
                            <p><b class="text-cyan-400">Frecuencia:</b> ~120 Hz</p>
                            <p><b class="text-purple-300">Causa:</b> Desgaste en electrodos o cable de alta tensión derivando corriente.</p>
                            <p><b class="text-emerald-400">Solución:</b> Revisar luz de bujías, calibrar separación o reemplazar juego completo y cables.</p>
                        </div>
                    </div>

                    <!-- 2. Pastillas de Freno -->
                    <div onclick="toggleFaultCard('card-freno')" class="glass-panel p-4 rounded-xl border border-slate-800 hover:border-purple-500/50 transition-all cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <div class="p-2 rounded-lg bg-cyan-950/60 text-cyan-300"><i data-lucide="disc" class="w-5 h-5"></i></div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-950/60 text-amber-400 border border-amber-800/40">Falla Media</span>
                        </div>
                        <h4 class="font-bold text-white mt-3 text-sm flex items-center justify-between">
                            Pastillas de Freno Desgastadas
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-cyan-400 transition-transform"></i>
                        </h4>
                        <p class="text-xs text-slate-400 mt-1">Chirrido metálico agudo al aplicar el pedal de freno.</p>
                        
                        <div id="card-freno" class="hidden mt-3 pt-3 border-t border-slate-800 space-y-2 text-xs text-slate-300">
                            <p><b class="text-cyan-400">Frecuencia:</b> ~3200 Hz</p>
                            <p><b class="text-purple-300">Causa:</b> Indicador físico de desgaste rozando contra el disco de freno.</p>
                            <p><b class="text-emerald-400">Solución:</b> Cambio inmediato de pastillas y rectificación o inspección de discos.</p>
                        </div>
                    </div>

                    <!-- 3. Soporte de Motor -->
                    <div onclick="toggleFaultCard('card-soporte')" class="glass-panel p-4 rounded-xl border border-slate-800 hover:border-purple-500/50 transition-all cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <div class="p-2 rounded-lg bg-indigo-950/60 text-indigo-300"><i data-lucide="shield-alert" class="w-5 h-5"></i></div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-950/60 text-amber-400 border border-amber-800/40">Falla Media</span>
                        </div>
                        <h4 class="font-bold text-white mt-3 text-sm flex items-center justify-between">
                            Soporte de Motor Roto
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-cyan-400 transition-transform"></i>
                        </h4>
