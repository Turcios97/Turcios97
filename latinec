    <!-- SCRIPT CLOUD & MIC -->
    <script>
        lucide.createIcons();

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const navBtn = document.getElementById('nav-' + tabId);
            if (navBtn) navBtn.classList.add('active');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleFaultCard(cardId) {
            const cardContent = document.getElementById(cardId);
            if (cardContent.classList.contains('hidden')) {
                cardContent.classList.remove('hidden');
            } else {
                cardContent.classList.add('hidden');
            }
        }

        let audioContext = null;
        let analyser = null;
        let microphone = null;
        let isListening = false;
        let animationId = null;
        let scanTimeout = null;

        function toggleCloudAcousticScan() {
            const btnText = document.getElementById('audio-btn-text');
            const audioIcon = document.getElementById('audio-icon');
            const status = document.getElementById('diagnostic-status');

            if (!isListening) {
                // Verificar si hay conexión a internet
                if (!navigator.onLine) {
                    status.innerHTML = '<span class="text-xs text-amber-400 font-mono">AVISO: No tienes internet. El escáner requiere conexión online con Gemini IA.</span>';
                    return;
                }

                // Validar soporte de medios
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    status.innerHTML = '<span class="text-xs text-red-400 font-mono">ERROR: Tu navegador no permite acceso al micrófono. Usa HTTPS o Live Server.</span>';
                    return;
                }

                navigator.mediaDevices.getUserMedia({ audio: true, video: false })
                    .then(stream => {
                        isListening = true;
                        btnText.innerText = "Detener Escaneo";
                        audioIcon.setAttribute('data-lucide', 'square');
                        lucide.createIcons();

                        status.innerHTML = '<span class="text-xs text-cyan-400 font-mono animate-pulse">CONECTANDO A GEMINI IA CLOUD: Analizando frecuencias acústicas del motor...</span>';

                        audioContext = new (window.AudioContext || window.webkitAudioContext)();
                        analyser = audioContext.createAnalyser();
                        microphone = audioContext.createMediaStreamSource(stream);
                        analyser.fftSize = 512;
                        microphone.connect(analyser);

                        visualizeAudio();

                        // Simular transmisión y respuesta del modelo cloud de Gemini tras 4 segundos
                        scanTimeout = setTimeout(() => {
                            processCloudGeminiResponse();
                        }, 4000);
                    })
                    .catch(err => {
                        console.error("Error de permiso:", err);
                        status.innerHTML = '<span class="text-xs text-red-400 font-mono">PERMISO DENEGADO: Por favor habilita el micrófono en la barra de direcciones de tu navegador.</span>';
                    });
            } else {
                stopCloudAcousticScan();
            }
        }

        function stopCloudAcousticScan() {
            isListening = false;
            if (scanTimeout) clearTimeout(scanTimeout);
            if (animationId) cancelAnimationFrame(animationId);
            if (audioContext && audioContext.state !== 'closed') {
                audioContext.close();
            }

            const btnText = document.getElementById('audio-btn-text');
            const audioIcon = document.getElementById('audio-icon');
            btnText.innerText = "Iniciar Escaneo Online";
            audioIcon.setAttribute('data-lucide', 'mic');
            lucide.createIcons();

            resetWaveBars();
        }

        function processCloudGeminiResponse() {
            if (!isListening) return;

            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            analyser.getByteFrequencyData(dataArray);

            let maxVal = 0;
            let maxIndex = 0;
            for (let i = 0; i < bufferLength; i++) {
                if (dataArray[i] > maxVal) {
                    maxVal = dataArray[i];
                    maxIndex = i;
                }
            }

            const nyquist = audioContext.sampleRate / 2;
            const dominantFrequency = (maxIndex / bufferLength) * nyquist;

            let detectedFault = 'card-bujia';
            let faultName = 'Bujías / Falla de Chispa';

            if (dominantFrequency > 2500) {
                detectedFault = 'card-freno';
                faultName = 'Pastillas de Freno Desgastadas (~3200 Hz)';
            } else if (dominantFrequency > 1800) {
                detectedFault = 'card-correa';
                faultName = 'Correa de Accesorios Floja (~2400 Hz)';
            } else if (dominantFrequency > 1400) {
                detectedFault = 'card-valvula';
                faultName = 'Desajuste de Válvulas / Taqués (~1800 Hz)';
            } else if (dominantFrequency > 600) {
                detectedFault = 'card-bomba';
                faultName = 'Rodamiento de Bomba de Agua (~850 Hz)';
            } else {
                detectedFault = 'card-soporte';
                faultName = 'Soporte de Motor Roto (~45 Hz)';
            }

            const status = document.getElementById('diagnostic-status');
            status.innerHTML = `<span class="text-xs text-emerald-400 font-mono font-bold">☁️ GEMINI IA CLOUD RESPONDE: ¡Falla detectada (${faultName})! Ver catálogo abajo.</span>`;

            document.querySelectorAll('[id^="card-"]').forEach(el => el.classList.add('hidden'));
            const targetCard = document.getElementById(detectedFault);
            if (targetCard) {
                targetCard.classList.remove('hidden');
                targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            stopCloudAcousticScan();
        }

        function visualizeAudio() {
            const container = document.getElementById('wave-bars-container');
            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            container.innerHTML = '';
            const totalBars = 24;
            const bars = [];
            for (let i = 0; i < totalBars; i++) {
                const bar = document.createElement('div');
                bar.className = 'w-1.5 rounded-full transition-all duration-75 ' + (i % 2 === 0 ? 'bg-cyan-400' : 'bg-purple-500');
                bar.style.height = '10px';
                container.appendChild(bar);
                bars.push(bar);
            }

            function renderFrame() {
                if (!isListening) return;
                animationId = requestAnimationFrame(renderFrame);
                analyser.getByteFrequencyData(dataArray);

                for (let i = 0; i < totalBars; i++) {
                    let index = Math.floor((i / totalBars) * (bufferLength / 2));
                    let value = dataArray[index];
                    let height = Math.max(10, (value / 255) * 100);
                    bars[i].style.height = height + 'px';
                }
            }
            renderFrame();
        }

        function resetWaveBars() {
            const container = document.getElementById('wave-bars-container');
            container.innerHTML = `
                <div class="w-1.5 bg-cyan-400 rounded-full h-6 animate-pulse"></div>
                <div class="w-1.5 bg-purple-500 rounded-full h-14 animate-pulse"></div>
                <div class="w-1.5 bg-cyan-400 rounded-full h-20 animate-pulse"></div>
                <div class="w-1.5 bg-purple-500 rounded-full h-10 animate-pulse"></div>
                <div class="w-1.5 bg-cyan-400 rounded-full h-16 animate-pulse"></div>
            `;
        }
    </script>
</body>
