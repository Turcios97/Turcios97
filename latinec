            </div>

            <div class="glass-panel p-6 rounded-2xl border-l-4 border-l-emerald-400 border border-purple-500/30 space-y-4 bg-gradient-to-r from-emerald-950/20 to-transparent max-w-2xl mx-auto">
                <div class="flex justify-between items-start">
                    <div>
